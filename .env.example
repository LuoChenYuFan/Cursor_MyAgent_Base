DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
OPENWEATHER_API_KEY=your-openweather-key
AMAP_API_KEY=your-amap-web-service-key
AMAP_SECRET=
SMTP_USER=your-sina-email@sina.com
SMTP_AUTH_CODE=your-smtp-auth-code
SMTP_HOST=smtp.sina.com
SMTP_PORT=465
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=postgres
AGENT_THREAD_ID=cli-local
EMAIL_SKIP_CONFIRM=0
API_HOST=127.0.0.1
API_PORT=8000
API_PUBLISH_PORT=8000
API_TOKEN=change-me-to-a-long-secret
MAX_CONCURRENT_RUNS=8
# Docker Compose 会覆盖：POSTGRES_HOST=postgres、API_HOST=0.0.0.0
# 本机 uv 跑 API 时保持 API_HOST=127.0.0.1 即可
# API_PUBLISH_PORT 只影响 Docker 对外映射。本机默认 8000；ECS 上与其他服务冲突时改为 9876
